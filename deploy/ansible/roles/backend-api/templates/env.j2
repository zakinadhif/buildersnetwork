NODE_ENV=production
PORT=8080
SERVE_STATIC={{ serve_static | default('false') }}

APP_URL={{ app_url }}
DATABASE_URL={{ database_url }}

STORAGE_DRIVER={{ storage_driver | default('disabled') }}
{% if storage_driver | default('disabled') == 's3' %}
STORAGE_REGION={{ storage_region | default('us-east-1') }}
STORAGE_ACCESS_KEY={{ storage_access_key }}
STORAGE_SECRET_KEY={{ storage_secret_key }}
STORAGE_BUCKET={{ storage_bucket }}
STORAGE_FORCE_PATH_STYLE={{ storage_force_path_style | default('false') }}
{% if storage_endpoint is defined %}
STORAGE_ENDPOINT={{ storage_endpoint }}
{% endif %}
{% endif %}

BETTER_AUTH_SECRET={{ better_auth_secret }}
BETTER_AUTH_URL={{ app_url }}

GEMINI_API_KEY={{ gemini_api_key }}

{% if google_client_id is defined %}
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
{% endif %}

ALLOWED_ORIGINS={{ allowed_origins | default(app_url) }}

FEATURE_FLAG_PROVIDER={{ feature_flag_provider | default('database') }}

{% if resend_api_key is defined %}
RESEND_API_KEY={{ resend_api_key }}
{% endif %}
{% if email_from is defined %}
EMAIL_FROM={{ email_from }}
{% endif %}
