# Frontend image — builds the SPA and landing page, serves via nginx.
# API_URL is injected at container runtime (not build time) via Docker env var.
# nginx processes /etc/nginx/templates/*.template with envsubst on startup.
#
# Build context is the repo root:
#   docker build -f deploy/Dockerfile.web -t buildersnetwork-web .
#   docker run -e API_URL=http://<backend-ip>:8080 buildersnetwork-web

# ---- deps ----
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/app/package.json apps/app/
COPY apps/landing/package.json apps/landing/
COPY libs/ai/package.json libs/ai/
COPY libs/api-client-react/package.json libs/api-client-react/
COPY libs/api-spec/package.json libs/api-spec/
COPY libs/api-zod/package.json libs/api-zod/
COPY libs/auth/package.json libs/auth/
COPY libs/config/package.json libs/config/
RUN pnpm install --frozen-lockfile

# ---- build ----
FROM deps AS build
COPY . .
RUN pnpm build:frontend

# ---- runtime ----
FROM nginx:alpine AS runtime

COPY --from=build /app/apps/landing/dist /usr/share/nginx/html/landing
COPY --from=build /app/apps/app/dist /usr/share/nginx/html/app

# nginx entrypoint runs envsubst on *.template files before starting.
# ${API_URL} is substituted from the runtime env var, not baked in at build time.
RUN mkdir -p /etc/nginx/templates && printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
\n\
    root /usr/share/nginx/html/landing;\n\
    index index.html;\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    location /app/ {\n\
        alias /usr/share/nginx/html/app/;\n\
        try_files $uri $uri/ /app/index.html;\n\
    }\n\
\n\
    location /api/ {\n\
        proxy_pass ${API_URL}/api/;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
}\n' > /etc/nginx/templates/default.conf.template

EXPOSE 80
