# Frontend image — builds the SPA and landing page, serves via nginx.
# The API_URL build arg sets the nginx proxy_pass target (backend EC2 IP).
#
# Build context is the repo root:
#   docker build -f deploy/Dockerfile.web --build-arg API_URL=http://<backend-ip>:8080 -t buildersnetwork-web .

# ---- deps ----
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/app/package.json apps/app/
COPY apps/landing/package.json apps/landing/
COPY libs/ai/package.json libs/ai/
COPY libs/api-client-react/package.json libs/api-client-react/
COPY libs/api-spec/package.json libs/api-spec/
COPY libs/api-zod/package.json libs/api-zod/
COPY libs/auth/package.json libs/auth/
COPY libs/config/package.json libs/config/
RUN pnpm install --frozen-lockfile

# ---- build ----
FROM deps AS build
COPY . .
RUN pnpm build:frontend

# ---- runtime ----
FROM nginx:alpine AS runtime

ARG API_URL
RUN test -n "$API_URL" || (echo "API_URL build arg is required" && exit 1)

COPY --from=build /app/apps/landing/dist /usr/share/nginx/html/landing
COPY --from=build /app/apps/app/dist /usr/share/nginx/html/app

RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
\n\
    root /usr/share/nginx/html/landing;\n\
    index index.html;\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    location /app/ {\n\
        alias /usr/share/nginx/html/app/;\n\
        try_files $uri $uri/ /app/index.html;\n\
    }\n\
\n\
    location /api/ {\n\
        proxy_pass '"$API_URL"'/api/;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
