node_modules
.cloudflare-state

# Local environment and Wrangler dev vars
**/.env.local
**/.env.*.local
**/.dev.vars
**/.dev.vars.*
!**/.env.example
!**/.dev.vars.example

# Playwright
**/test-results/
**/playwright-report/
**/blob-report/
**/.playwright/

# Build outputs
dist/
dist-mockups/
.astro/

# TypeScript build info
*.tsbuildinfo

# Claude Code chat dumps and handoff documents
/.claude-chat/

# Claude Code local settings and agent worktrees (per-machine / transient)
.claude/settings.local.json
.claude/worktrees/

# Impeccable tool cache (per-machine / transient)
.impeccable/

# Generated API client and Zod schemas
libs/api-client-react/src/generated/
libs/api-zod/src/generated/

# Ansible secret vault
deploy/ansible/group_vars/all/vault.yml
.vagrant

# Local SQLite database files (libSQL). The dev DB is disposable —
# `pnpm db:migrate && pnpm db:seed` rebuilds it.
*.db
*.db-journal
*.db-wal
*.db-shm
# Wrangler's local D1 / Miniflare state
.wrangler/

# Per-PR preview config, rendered in CI from wrangler.preview.template.toml.
# It carries a live database_id and the preview auth secret.
wrangler.preview.toml

# Built developer guides. The scripts in docs/ are the source — rebuild with
# `python docs/build-guide-en.py` (needs python-docx).
docs/*.docx
__pycache__/
