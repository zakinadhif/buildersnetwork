# API-only image — no static frontend assets bundled in.
# Use this for the 3-tier EC2 deployment where a dedicated nginx VM serves the
# SPA and landing. Set SERVE_STATIC=false to disable Hono's static middleware.
#
# Build context is the repo root:
#   docker build -f deploy/Dockerfile.api -t buildersnetwork-api .

# ---- deps ----
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY libs/ai/package.json libs/ai/
COPY libs/api-spec/package.json libs/api-spec/
COPY libs/api-zod/package.json libs/api-zod/
COPY libs/auth/package.json libs/auth/
COPY libs/config/package.json libs/config/
COPY libs/db/package.json libs/db/
COPY libs/storage/package.json libs/storage/
RUN pnpm install --frozen-lockfile

# ---- build ----
FROM deps AS build
COPY . .
RUN pnpm codegen
RUN pnpm --filter api build
RUN pnpm --filter api deploy --prod --legacy /prod/api

# ---- runtime ----
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8080 \
    SERVE_STATIC=false

COPY --from=build /prod/api/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/package.json ./package.json
COPY --from=build /app/libs/db/migrations ./migrations

EXPOSE 8080
USER node
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD wget -qO- http://localhost:8080/healthz || exit 1
CMD ["node", "dist/index.js"]
