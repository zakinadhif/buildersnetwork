# Local development env for the API. Copy to .env and adjust.
# In production these are set via your platform's secret manager — see
# deploy/.env.example for the canonical, fully-documented reference.

NODE_ENV=development
PORT=8080

# Public origin the browser uses. In split dev (Vite on 5173) this is the
# Vite origin; in the bundled container it's the single public URL.
APP_URL=http://localhost:5173

# libSQL URL. `file:` is a plain SQLite file — no database server to run.
# Create it with: pnpm db:migrate && pnpm db:seed
#
# The path is relative to this package (`apps/api`, the cwd of `pnpm dev:api`
# and `pnpm db:seed`) and points at the same file `pnpm db:migrate` writes —
# drizzle-kit runs in `libs/db`, where that file lives.
#
# Point at a hosted Turso database with `libsql://…` + DATABASE_AUTH_TOKEN.
DATABASE_URL=file:../../libs/db/local.db
# DATABASE_AUTH_TOKEN=   # only for a remote libsql:// URL

# Object storage (S3-compatible). Optional locally unless you touch uploads.
# These point at the MinIO service in docker-compose.dev.yml.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=comfort-dev
STORAGE_FORCE_PATH_STYLE=true

# Auth (Better Auth). Secret must be at least 32 characters.
BETTER_AUTH_SECRET=dev-secret-change-me-this-is-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS allowlist (comma-separated). Defaults to APP_URL when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4321,http://127.0.0.1:4321
