# =============================================================================
# Canonical environment reference for Comfort Stack.
#
# Every variable the app reads is listed here. In production set these via your
# platform's secret manager (`wrangler secret put` on Cloudflare, Ansible vault
# on EC2) or, for self-hosted compose, copy this file to deploy/.env and fill it
# in.
#
# Validated at startup by libs/config — the app fails fast on missing/invalid
# values. The one exception is SERVE_STATIC (see below), which the Node entry
# reads straight from process.env.
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=production
# Port the Hono server listens on. 8080 is the convention across all manifests.
PORT=8080
# Public origin the app is served from (used for auth callbacks and links).
APP_URL=https://example.com

# --- Database (SQLite / libSQL) -----------------------------------------------
# A libSQL URL. Three shapes, same schema and code:
#   file:/data/app.db   — a local SQLite file (self-hosted compose / single VM)
#   libsql://<db>.turso.io  — a hosted Turso database (managed PaaS); set
#                             DATABASE_AUTH_TOKEN alongside it
#   :memory:            — ephemeral, for tests only
# On Cloudflare there is no DATABASE_URL at all — the Worker binds a D1 database.
DATABASE_URL=file:/data/app.db
# Auth token for a remote libsql:// (Turso) URL. Leave blank for file:/:memory:.
DATABASE_AUTH_TOKEN=

# --- Object storage (S3-compatible) -------------------------------------------
# One adapter, four providers. The only knobs that vary are STORAGE_ENDPOINT
# and STORAGE_FORCE_PATH_STYLE. See deploy/docs/STORAGE_PROVIDERS.md.
# Optional as a group: omit all of these to run without object storage.
#
#   Cloudflare R2 : STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com  REGION=auto   PATH_STYLE=false
#   Backblaze B2  : STORAGE_ENDPOINT=https://s3.<region>.backblazeb2.com         REGION=<rgn>  PATH_STYLE=false
#   AWS S3        : STORAGE_ENDPOINT=(omit)                                      REGION=<rgn>  PATH_STYLE=false
#   MinIO         : STORAGE_ENDPOINT=http://minio:9000                           REGION=us-east-1 PATH_STYLE=true
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_FORCE_PATH_STYLE=false

# --- Auth (Better Auth) -------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Defaults to APP_URL when unset.
BETTER_AUTH_URL=
# Google OAuth (optional — leave blank to disable the Google provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CORS ---------------------------------------------------------------------
# Comma-separated allowlist of browser origins. Defaults to APP_URL when unset.
ALLOWED_ORIGINS=

# --- Admin ---------------------------------------------------------------------
# Comma-separated allowlist of team emails who may feature karya (no RBAC).
ADMIN_EMAILS=

# --- AI -----------------------------------------------------------------------
# The provider is chosen by the runtime entrypoint, NOT by an env var:
#   apps/api/src/index.ts  (Node / Docker)      -> createGeminiAI   -> GEMINI_API_KEY
#   apps/api/src/worker.ts (Cloudflare Workers) -> createWorkersAI  -> the CF `AI`
#                                                   binding, no key needed
# Required for Node / Docker deployments.
GEMINI_API_KEY=
# Only needed if you switch index.ts to createAnthropicAI.
ANTHROPIC_API_KEY=
# Workers AI model override. Defaults to @cf/meta/llama-4-scout-17b-16e-instruct.
AI_WORKERS_MODEL=

# --- Email --------------------------------------------------------------------
# Provider: set RESEND_API_KEY to send via Resend; otherwise email is suppressed
# (no-op) in Node deployments. On Cloudflare the [[send_email]] binding is the
# default and RESEND_API_KEY overrides it. In practice Resend is the live sender
# in production — [[send_email]] needs Workers Paid and is dormant on the free
# tier.
RESEND_API_KEY=
# Cloudflare Email REST API — an alternative to Resend. Set both or neither.
CF_EMAIL_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
# Sender address for outgoing email. Its domain must be verified with the active
# provider. Defaults to "Al-Fath Berkarya <noreply@buildersnetwork.web.id>".
EMAIL_FROM=

# --- Static file serving ------------------------------------------------------
# Set to `false` to stop Hono serving the built SPA + landing — used by the
# 2-tier EC2 deployment, where nginx serves static files on a separate VM.
# NOTE: read directly from process.env by apps/api/src/index.ts, not validated
# by libs/config.
SERVE_STATIC=

# --- Self-hosted compose only -------------------------------------------------
# Used by deploy/docker-compose.selfhost.yml for Caddy + app + MinIO. The
# database is a SQLite file on the shared `dbdata` volume (DATABASE_URL above is
# overridden to file:/data/app.db there) — no database password to set.
APP_DOMAIN=example.com
# Optionally pin a prebuilt image instead of building from source:
# APP_IMAGE=ghcr.io/<owner>/comfort-stack:latest
